{
  "name": "@fnclaude/renderer",
  "version": "3.3.1",
  "type": "module",
  "description": "Configurable TUI front-end for Claude Code with stream-json driving, toggleable visibility filters, and native Ink markdown rendering.",
  "license": "MIT",
  "author": "fnrhombus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fnclaude/fnclaude.git",
    "directory": "packages/renderer"
  },
  "bin": {
    "fnclaude-renderer": "./src/index.tsx"
  },
  "main": "./src/mount.tsx",
  "exports": {
    ".": "./src/mount.tsx"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/index.tsx",
    "build": "bun build --compile --outfile=bin/fnclaude-renderer ./src/index.tsx",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "fmt": "biome format --write .",
    "lint": "biome lint .",
    "test": "bun test"
  },
  "dependencies": {
    "cli-highlight": "^2.1.11",
    "entities": "^8.0.0",
    "gemoji": "^8.1.0",
    "ink": "^7.1.0",
    "marked": "^18.0.5",
    "react": "^19.0.0",
    "react-devtools-core": "^7.0.1",
    "remend": "^1.3.0",
    "supports-hyperlinks": "^4.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/react": "^19.0.0",
    "bun-types": "^1.3.14",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
