---
/**
 * The rhombus mascot: a leaning body on four legs, drawn as run-length rects
 * on a 14x7 pixel grid. Regenerate the grid with scripts/mascot.py.
 *
 * Fills with `currentColor` and carries no intrinsic size, so colour and
 * width both come from the caller's class.
 */
interface Props {
  /** Optional inline width override, e.g. "2rem". Prefer sizing via `class`. */
  width?: string;
  class?: string;
}

const { width, class: className } = Astro.props;
---

<svg
  class={className}
  style={width ? `width: ${width}` : undefined}
  viewBox="0 0 14 7"
  shape-rendering="crispEdges"
  role="img"
  aria-label="fnclaude mascot: a leaning rhombus creature"
>
  <g fill="currentColor">
    <rect x="4" y="0" width="10" height="1" />
    <rect x="3" y="1" width="3" height="1" />
    <rect x="7" y="1" width="3" height="1" />
    <rect x="11" y="1" width="2" height="1" />
    <rect x="2" y="2" width="4" height="1" />
    <rect x="7" y="2" width="3" height="1" />
    <rect x="11" y="2" width="1" height="1" />
    <rect x="1" y="3" width="10" height="1" />
    <rect x="0" y="4" width="10" height="1" />
    <rect x="1" y="5" width="1" height="1" />
    <rect x="3" y="5" width="1" height="1" />
    <rect x="6" y="5" width="1" height="1" />
    <rect x="8" y="5" width="1" height="1" />
    <rect x="1" y="6" width="1" height="1" />
    <rect x="3" y="6" width="1" height="1" />
    <rect x="6" y="6" width="1" height="1" />
    <rect x="8" y="6" width="1" height="1" />
  </g>
</svg>
