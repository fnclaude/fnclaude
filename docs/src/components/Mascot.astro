---
/**
 * The rhombus mascot: a leaning body on two legs with slot eyes and a
 * half-disc smile, drawn as run-length rects on a 16x9 pixel grid.
 * Regenerate the grid with scripts/mascot.py.
 *
 * Fills with `currentColor` and carries no intrinsic size, so colour and
 * width both come from the caller's class.
 */
interface Props {
  /** Optional inline width override, e.g. "2rem". Prefer sizing via `class`. */
  width?: string;
  class?: string;
}

const { width, class: className } = Astro.props;
---

<svg
  class={className}
  style={width ? `width: ${width}` : undefined}
  viewBox="0 0 16 9"
  shape-rendering="crispEdges"
  role="img"
  aria-label="fnclaude mascot: a smiling, leaning rhombus creature"
>
  <g fill="currentColor">
    <rect x="6" y="0" width="10" height="1" />
    <rect x="5" y="1" width="3" height="1" />
    <rect x="9" y="1" width="3" height="1" />
    <rect x="13" y="1" width="2" height="1" />
    <rect x="4" y="2" width="4" height="1" />
    <rect x="9" y="2" width="3" height="1" />
    <rect x="13" y="2" width="1" height="1" />
    <rect x="3" y="3" width="10" height="1" />
    <rect x="2" y="4" width="4" height="1" />
    <rect x="10" y="4" width="2" height="1" />
    <rect x="1" y="5" width="6" height="1" />
    <rect x="9" y="5" width="2" height="1" />
    <rect x="0" y="6" width="10" height="1" />
    <rect x="2" y="7" width="1" height="1" />
    <rect x="7" y="7" width="1" height="1" />
    <rect x="2" y="8" width="1" height="1" />
    <rect x="7" y="8" width="1" height="1" />
  </g>
</svg>
